#    Command line to run this workspace:
#        fme.exe OpenStreetMapInAR.fmw
#          --LOCATION "<opencurly><tab><quote>coordinates<quote>:<space><openbracket><tab><tab>-123.1195<comma><tab><tab>49.2833<tab><closebracket><comma><tab><quote>type<quote>:<space><quote>Point<quote><closecurly>"
