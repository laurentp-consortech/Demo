# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {FeatureReader_2__Rejected__d9e64763_8c08_4f3d_acba_e7ea3c5aef453} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME FeatureReader_2__Rejected_
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { FeatureReader_2__Rejected__Logger }    INPUT  FEATURE_TYPE FeatureReader_2_<REJECTED>    OUTPUT { FEATURE_TYPE FeatureReader_2__Rejected__LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>OSM<space>data<space>reading<space>error","20","20","",ERROR,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "FeatureReader_2__Rejected_ LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE FeatureReader_2__Rejected__LOGGED
