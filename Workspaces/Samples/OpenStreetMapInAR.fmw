MACRO $(3DArrowReplacer_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_XFORMER_NAME 3DArrowReplacer
MACRO $(3DArrowReplacer_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_XSCALE 1
