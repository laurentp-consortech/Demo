separen> = sculpture'statue'BOOL_OP;COMPOSITE;COMPOSITE_TEST;( 1 OR 2 ) AND ( 3 OR 4 );TEST <at>Value<openparen>fme_feature_type<closeparen> = amenity;TEST <at>Value<openparen>fme_feature_type<closeparen> = building;TEST <at>Value<openparen>artwork_type<closeparen> = sculpture;TEST <at>Value<openparen>artwork_type<closeparen> = statue'statue'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2 AND 3;TEST <at>Value<openparen>fme_feature_type<closeparen> = tourism;TEST <at>Value<openparen>tourism<closeparen> = artwork;TEST artwork_type NOT_ATTRIBUTE_IS_MISSING _FME_BLANK_STRING_'<at>Value<openparen>artwork_type<closeparen>'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2;TEST <at>Value<openparen>fme_feature_type<closeparen> = tourism;TEST <at>Value<openparen>tourism<closeparen> = artwork'statue'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2;TEST <at>Value<openparen>fme_feature_type<closeparen> = tourism;TEST <at>Value<openparen>tourism<closeparen> = information'information'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2;TEST <at>Value<openparen>fme_feature_type<closeparen> = tourism;TEST <at>Value<openparen>tourism<closeparen> = museum'museum'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2;TEST <at>Value<openparen>fme_feature_type<closeparen> = building;TEST <at>Value<openparen>tourism<closeparen> = museum'museum'BOOL_OP;COMPOSITE;COMPOSITE_TEST;1 AND 2 OR 3;TEST <at>Value<openparen>fme_feature_type<closeparen> = building;TEST <at>Value<openparen>landuse<closeparen> = retail;TEST <at>Value<openparen>buildingType<closeparen> = retail'shop'BOOL_OP;COMPOSITE;COMPOSITE_TEST;1 OR 2 AND 3;TEST <at>Value<openparen>fme_feature_type<closeparen> = tourism;TEST <at>Value<openparen>fme_feature_type<closeparen> = building;TEST <at>Value<openparen>tourism<closeparen> IN hotel<comma>hostel<comma>guest_house<comma>shelter'accommodation'BOOL_OP;AND;COMPOSITE_TEST;1 AND 2;TEST <at>Value<openparen>fme_feature_type<closeparen> = shop;TEST <at>Value<openparen>shop<closeparen> IN clothes<comma>florist<comma>beauty<comma>bakery<comma>convenience<comma>deli<comma>supermarket<comma>gift'<at>Value<openparen>shop<closeparen>'BOOL_OP;AND;COMPOSITE_TEST;1;TEST <at>Value<openparen>fme_feature_type<closeparen> = shop'shop'FME_NUM_CONDITIONS17___" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_3_OUTPUT        }
