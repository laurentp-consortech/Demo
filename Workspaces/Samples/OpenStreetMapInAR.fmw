   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {acAngle}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<openparen><openparen><at>Value<openparen>acY2<closeparen>-<at>Value<openparen>acY1<closeparen><closeparen><lt>0<closeparen>?<openparen>360-<at>Value<openparen>acAngle<closeparen><closeparen>:<openparen><at>Value<openparen>acAngle<closeparen><closeparen>};     lappend parmList {FLOAT};    };    lappend parmList {$(AzimuthCalculator_WORKSPACE_NAME)_EXPRESSIONEVALUATOR_6};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
