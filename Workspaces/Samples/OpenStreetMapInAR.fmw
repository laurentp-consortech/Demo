# -------------------------------------------------------------------------
# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr
MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry5<closeparen>,$(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{fmehex} == {fmebinary} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{fmehex} == {fmehex} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{fmehex} == {fmexml} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmehex} == {fmexmlencoded} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{fmehex} == {polyline} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{fmehex} == {wkt} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmehex,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmehex} == {wkb} ||                      {fmehex} == {wkbhex} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmehex,\"$geomSrcAttr\")";           } elseif {{fmehex} == {GEOJSON} ||                     {fmehex} == {ESRIJSON} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @JSONGeometry(FROM_ATTRIBUTE,fmehex,\"$geomSrcAttr\")";           } elseif {{fmehex} == {GEORSS} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmehex} == {KML} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmehex} == {GML} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmehex} == {geohash} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmehex} == {ogeosms} ||                     {fmehex} == {geosms}  ||                     {fmehex} == {geo} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmehex,\"$geomSrcAttr\")";           } elseif {{fmehex} == {mgrs}} {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry5<closeparen>,$(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer)\")"           } elseif {{fmehex} == {mssql} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @SerializeGeometry(from_attribute,fmehex,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmehex} == {iso6709} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmehex} == {qlikmaps} } {               puts "MACRO $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Rejector }    COMMAND_PARM_EVALUATION SINGLE_PASS    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    INPUT  FEATURE_TYPE "$(3DArrowReplacer_WORKSPACE_NAME)_AttributeCreator_5_OUTPUT"    $($(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr)    FUNCTION_DEFINITION { $($(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_Function) }    OUTPUT { COMPLETE FEATURE_TYPE "$(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_OUTPUT"        $($(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr) $($(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr) }    OUTPUT { REJECTED FEATURE_TYPE "$(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_<REJECTED>"        $($(3DArrowReplacer_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr) }
