# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {AppearanceSetter_7__Rejected__77c7402a_3e11_42ac_a35f_8c02678ed0883} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME AppearanceSetter_7__Rejected_
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AppearanceSetter_7__Rejected__Logger }    INPUT  FEATURE_TYPE AppearanceSetter_7_<REJECTED>    OUTPUT { FEATURE_TYPE AppearanceSetter_7__Rejected__LOGGED                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Feature is:","20","20","",INFO,LOG_ONLY,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "AppearanceSetter_7__Rejected_ LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE AppearanceSetter_7__Rejected__LOGGED
