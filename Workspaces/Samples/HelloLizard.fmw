ARCGIS_COMPATIBILITY ARCGIS_AUTO
GUI IGNORE SourceDataset_OBJ_3,OBJ_IN_FME_GROUP_NAMED1_OBJ_3,OBJ_IN_MERGE_MESH_PARTS_OBJ_3,OBJ_IN_FME_GROUP_NAMED2_OBJ_3,OBJ_IN_MOVE_TO_WORLD_COORDSYS_OBJ_3,OBJ_IN_USE_SEARCH_ENVELOPE_OBJ_3,OBJ_IN_SEARCH_ENVELOPE_MINX_OBJ_3,OBJ_IN_SEARCH_ENVELOPE_MINY_OBJ_3,OBJ_IN_SEARCH_ENVELOPE_MAXX_OBJ_3,OBJ_IN_SEARCH_ENVELOPE_MAXY_OBJ_3,OBJ_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_OBJ_3,OBJ_IN_CLIP_TO_ENVELOPE_OBJ_3,OBJ_IN_NETWORK_AUTHENTICATION_OBJ_3,DestDataset_FME_AR_1,FME_AR_OUT_SCALEGRP_FME_AR_1,FME_AR_OUT_SCALE_FME_AR_1,FME_AR_OUT_NUMERICSCALE_FME_AR_1,FME_AR_OUT_ADVANCED_GROUP_FME_AR_1,FME_AR_OUT_SUPPORT_DEVICES_FME_AR_1
