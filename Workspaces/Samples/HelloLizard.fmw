MULTI_READER_GEN_DIRECTIVES{0} EXPOSE_ATTRS_GROUP,,SEARCH_ENVELOPE_MAXY,0,MERGE_MESH_PARTS,No,SEARCH_ENVELOPE_COORDINATE_SYSTEM,,SEARCH_ENVELOPE_MAXX,0,VARIABLE_FEATURE_TYPES,yes,USE_SEARCH_ENVELOPE,NO,MOVE_TO_WORLD_COORDSYS,Yes,SEARCH_ENVELOPE_MINX,0,CLIP_TO_ENVELOPE,NO,_MERGE_SCHEMAS,YES,OBJ_EXPOSE_FORMAT_ATTRS,,SEARCH_ENVELOPE_MINY,0
