#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="35"
#! />
#! <COMMENT
#!   IDENTIFIER="15"
#!   COMMENT_VALUE="&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;&#10;&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;&#10;p, li { white-space: pre-wrap; }&#10;hr { height: 1px; border-width: 0; }&#10;li.unchecked::marker { content: &quot;\2610&quot;; }&#10;li.checked::marker { content: &quot;\2612&quot;; }&#10;&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:&apos;helvetica&apos;; font-size:13pt; font-weight:400; font-style:normal;&quot;&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;a name=&quot;docs-internal-guid-97382d60-7fff-da8f-351a-ca78bb827703&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;P&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;urpose &amp;amp; Objectives&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;This workspace displays a model of the FME Lizard mascot in the FME Realize app. The FME Lizard also has a summary annotation created when the user points at the model in the app.&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;Key Transformer&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;a href=&quot;https://docs.safe.com/fme/html/FME-Form-Documentation/FME-Transformers/Transformers/attributecreator.htm&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; text-decoration: underline;&quot;&gt;AttributeCreator&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000;&quot;&gt;: Creates a summary annotation on the FME Lizard feature.&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;Data Source(s) - Reader Feature Type&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; background-color:transparent;&quot;&gt;&lt;a href=&quot;https://docs.safe.com/fme/html/FME-Form-Documentation/FME-ReadersWriters/obj/obj.htm&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; text-decoration: underline; background-color:transparent;&quot;&gt;OBJ Reader&lt;/span&gt;&lt;/a&gt;&lt;a href=&quot;https://docs.safe.com/fme/html/FME-Form-Documentation/FME-ReadersWriters/flatgeobuf/flatgeobuf.htm?Highlight=flatGeobuf&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; text-decoration: underline; color:#0078d4; background-color:transparent;&quot;&gt; &lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;reads in the FME Lizard 3D model as a .obj file&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000; background-color:transparent;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;Data Output - Writer Feature Type&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%; background-color:transparent;&quot;&gt;&lt;a href=&quot;https://docs.safe.com/fme/html/FME-Form-Documentation/FME-ReadersWriters/fme_ar/fme_ar.htm?&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; text-decoration: underline; background-color:transparent;&quot;&gt;FME AR Writer&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt; saves the geometry into a form that is overlaid on a live view in AR&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000;&quot;&gt;&lt;br /&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:12pt; font-weight:700; color:#000000; background-color:transparent;&quot;&gt;Customization&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;To customize this workspace, you can change the following:&lt;/span&gt;&lt;/p&gt;&#10;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&#10;&lt;li style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;Attributes to display in AR as summary annotations with the AttributeCreator transformer&lt;/li&gt;&#10;&lt;li style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;3D model of the FME Lizard with your own model&lt;/li&gt;&lt;/ul&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;If you&apos;re recreating this workspace with your own data, it is recommended to build the workspace from scratch as your dataset will have different attributes and schema (structure).&lt;/span&gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000; background-color:transparent;&quot;&gt;&lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;For help with this workspace, please contact&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000; background-color:transparent;&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://support.safe.com/hc/p/Support&quot;&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; text-decoration: underline; background-color:transparent;&quot;&gt;Safe Software Support&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; color:#000000; background-color:transparent;&quot;&gt;  &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; color:#000000; background-color:transparent;&quot;&gt;and reference&lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:9pt; font-style:italic; color:#000000; background-color:transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-family:&apos;Segoe UI&apos;; font-size:10pt; font-style:italic; color:#000000; background-color:transparent;&quot;&gt;FME AR: Hello Lizard.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"
