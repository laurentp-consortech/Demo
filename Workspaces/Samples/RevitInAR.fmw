GUI LOOKUP REVITNATIVE_IN_SEARCH_ENVELOPE_MINX_REVITNATIVE_2 <Unused>,0 
DEFAULT_MACRO REVITNATIVE_IN_SEARCH_ENVELOPE_MINX_REVITNATIVE_2 0
REVITNATIVE_2_SEARCH_ENVELOPE "$(REVITNATIVE_IN_SEARCH_ENVELOPE_MINX_REVITNATIVE_2)"
