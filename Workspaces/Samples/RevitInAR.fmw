FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   INPUT FEATURE_TYPE *    ROUTE REVITNATIVE REVITNATIVE_2::Architectural.Furniture multi_reader_keyword,$(DATASET_KEYWORD_REVITNATIVE_2) TO FME_GENERIC ::Architectural.Furniture ALIAS_GEOMETRY    ROUTE REVITNATIVE REVITNATIVE_2::Architectural.Casework multi_reader_keyword,$(DATASET_KEYWORD_REVITNATIVE_2) TO FME_GENERIC ::Architectural.Casework ALIAS_GEOMETRY    ROUTE REVITNATIVE REVITNATIVE_2::Architectural.Rooms multi_reader_keyword,$(DATASET_KEYWORD_REVITNATIVE_2) TO FME_GENERIC ::Architectural.Rooms ALIAS_GEOMETRY    ROUTE JPEG JPEG_1::JPEG multi_reader_keyword,$(DATASET_KEYWORD_JPEG_1) TO FME_GENERIC ::JPEG ALIAS_GEOMETRY    ROUTE OBJ OBJ_2::PlumbingFixtures multi_reader_keyword,$(DATASET_KEYWORD_OBJ_2) TO FME_GENERIC ::PlumbingFixtures ALIAS_GEOMETRY    ROUTE 3DS 3DS_1::Appl multi_reader_keyword,$(DATASET_KEYWORD_3DS_1) TO FME_GENERIC ::Appl ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
