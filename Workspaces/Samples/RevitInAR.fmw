Tcl2 proc AppearanceStyler_2_Warning {} {    global AppearanceStyler_2_Warned;    incr AppearanceStyler_2_Warned;    if { $AppearanceStyler_2_Warned <= 1 } {       FME_LogMessage fme_warn \"AppearanceStyler_2: Unsupported geometry found. Removing all unsupported geometry from feature\";    }; }
