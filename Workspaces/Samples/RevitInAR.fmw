 puts {DEFAULT_MACRO SourceDataset_REVITNATIVE_2 $(SourceDataset)}     \
 } ]
#! END_WB_HEADER
#! START_SOURCE_HEADER REVITNATIVE REVITNATIVE_2
DEFAULT_MACRO SourceDataset_REVITNATIVE_2 $(FME_MF_DIR)Duplex_A.rvt
GUI MULTIFILE SourceDataset_REVITNATIVE_2 RevitNative_Files/Revit_Template_Files(*.rvt;*.rte)|*.rvt;*rte|RevitNative_Files(*.rvt)|*.rvt|Revit_Template_Files(*.rte)|*.rte|All_Files(*)|* Revit Project File(s):
# =====================================================================
# Provide some control over what attributes have the user-selected
# encoding applied. Normally all attributes are updated after being
# read, but the following lines exclude from this treatment all
# attributes whose names start with fme_ or revitnative_.
REVITNATIVE_2_UNENCODED_ATTR_PREFIX fme_ revitnative_
DEFAULT_MACRO REVITNATIVE_IN_READER_PARAMETERS_REVITNATIVE_2 FME_DISCLOSURE_OPEN
GUI OPTIONAL DISCLOSUREGROUP REVITNATIVE_IN_READER_PARAMETERS_REVITNATIVE_2 REVITNATIVE_IN_READ_MODE_REVITNATIVE_2%REVITNATIVE_IN_GEOM_HANDLING_MODE_REVITNATIVE_2%REVITNATIVE_IN_DETAIL_LEVEL_SETTING_REVITNATIVE_2%REVITNATIVE_IN_COORD_SYS_MODE_REVITNATIVE_2%REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2 Reader Parameters
#=============================================================================
# Read mode
DEFAULT_MACRO REVITNATIVE_IN_READ_MODE_REVITNATIVE_2 All
REVITNATIVE_2_READ_MODE "$(REVITNATIVE_IN_READ_MODE_REVITNATIVE_2)"
GUI ACTIVECHOICE_LOOKUP REVITNATIVE_IN_READ_MODE_REVITNATIVE_2 All<space>Elements,All%Exterior<space>Shell<space>Only,Exterior%Schedules,Schedules,REVITNATIVE_IN_GEOM_HANDLING_MODE_REVITNATIVE_2,REVITNATIVE_IN_DETAIL_LEVEL_SETTING_REVITNATIVE_2,REVITNATIVE_IN_COORD_SYS_MODE_REVITNATIVE_2,REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2,++REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2+ Read:
#=============================================================================
# Geometry handling modes
DEFAULT_MACRO REVITNATIVE_IN_GEOM_HANDLING_MODE_REVITNATIVE_2 Surface
REVITNATIVE_2_GEOM_HANDLING_MODE "$(REVITNATIVE_IN_GEOM_HANDLING_MODE_REVITNATIVE_2)"
GUI ACTIVECHOICE_LOOKUP REVITNATIVE_IN_GEOM_HANDLING_MODE_REVITNATIVE_2 Surfaces,Surface,REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2,++REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2+%Wireframes,Wireframe,REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2,++REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2+%Floor<space>Plans,Floorplan,++REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2+%Non-spatial,Nonspatial,REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2,++REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2+ Read Geometry As:
#=============================================================================
# Specify a detail level to read elements in
DEFAULT_MACRO REVITNATIVE_IN_DETAIL_LEVEL_SETTING_REVITNATIVE_2 Use_view_setting
REVITNATIVE_2_DETAIL_LEVEL_SETTING "$(REVITNATIVE_IN_DETAIL_LEVEL_SETTING_REVITNATIVE_2)"
GUI LOOKUP_CHOICE REVITNATIVE_IN_DETAIL_LEVEL_SETTING_REVITNATIVE_2 Respect<space>Original<space>View<space>Setting,Use_view_setting%Fine,Fine%Medium,Medium%Coarse,Coarse Geometry Detail Level:
#=============================================================================
# Read and project into coordinate system
DEFAULT_MACRO REVITNATIVE_IN_COORD_SYS_MODE_REVITNATIVE_2 Georeferenced
REVITNATIVE_2_COORD_SYS_MODE "$(REVITNATIVE_IN_COORD_SYS_MODE_REVITNATIVE_2)"
GUI LOOKUP_CHOICE REVITNATIVE_IN_COORD_SYS_MODE_REVITNATIVE_2 Project,Project%Georeferenced,Georeferenced Revit Coordinate System to Read:
# ============================================================================
# Give the user the ability to turn occlusion on or off
DEFAULT_MACRO REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2 <Unused>
REVITNATIVE_2_PERFORM_OCCLUSION "$(REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2)"
GUI LOOKUP_CHOICE REVITNATIVE_IN_PERFORM_OCCLUSION_REVITNATIVE_2 Hidden<space>Line,yes%Wireframe,no Floor Plan Render Mode
# Should we read only a certain view?
DEFAULT_MACRO REVITNATIVE_IN_READ_SELECTED_VIEW_REVITNATIVE_2 NO
REVITNATIVE_2_READ_SELECTED_VIEW "$(REVITNATIVE_IN_READ_SELECTED_VIEW_REVITNATIVE_2)"
GUI ACTIVEDISCLOSUREGROUP REVITNATIVE_IN_READ_SELECTED_VIEW_REVITNATIVE_2 REVITNATIVE_IN_SELECTED_VIEW_REVITNATIVE_2 Specify View to Read
# Indicate which view we will read
