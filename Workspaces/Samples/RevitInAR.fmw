# Include this file in source setting section to add external search envelope processing
# Zero as a default means we don't do any search -- this makes workbench happier
DEFAULT_MACRO REVITNATIVE_IN_USE_SEARCH_ENVELOPE_REVITNATIVE_2 NO
REVITNATIVE_2_USE_SEARCH_ENVELOPE "$(REVITNATIVE_IN_USE_SEARCH_ENVELOPE_REVITNATIVE_2)"
GUI ACTIVEDISCLOSUREGROUP REVITNATIVE_IN_USE_SEARCH_ENVELOPE_REVITNATIVE_2 REVITNATIVE_IN_SEARCH_ENVELOPE_MINX_REVITNATIVE_2%REVITNATIVE_IN_SEARCH_ENVELOPE_MINY_REVITNATIVE_2%REVITNATIVE_IN_SEARCH_ENVELOPE_MAXX_REVITNATIVE_2%REVITNATIVE_IN_SEARCH_ENVELOPE_MAXY_REVITNATIVE_2%REVITNATIVE_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_REVITNATIVE_2%REVITNATIVE_IN_CLIP_TO_ENVELOPE_REVITNATIVE_2%REVITNATIVE_IN_SEARCH_METHOD%REVITNATIVE_IN_SEARCH_METHOD_FILTER%REVITNATIVE_IN_SEARCH_ORDER%REVITNATIVE_IN_SEARCH_FEATURE%REVITNATIVE_IN_DUMMY_SEARCH_ENVELOPE_PARAMETER Use Search Envelope
